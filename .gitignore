# Allowlist: ignore everything in wp-content, then opt in only code we own.
# Core, database, uploads, and third-party plugins/themes are per-environment.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/.github/workflows/
!/.github/workflows/deploy.yml

# Our theme
!/themes/
/themes/*
!/themes/nad/

# Our custom plugins (add a line per plugin we write)
!/plugins/
/plugins/*
!/plugins/nad-core/
!/plugins/evercrest-core/

# Never commit, even inside tracked folders
node_modules/
vendor/
# ...except hand-vendored front-end libs (e.g. Swiper): no install step, so they must ship in git
!/themes/nad/assets/vendor/
*.log
.env
.env.*
.DS_Store
Thumbs.db
.idea/
.vscode/
